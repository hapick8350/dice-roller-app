# 포트
PORT=3000

# ── 로그인 ─────────────────────────────────────────────
# byd   : SAP ByD 사용자 ID/비밀번호로 로그인 (BYD_BASE_URL 필요)
# local : 아래 APP_USERS 계정으로 로그인
# none  : 로그인 없음 (체험용)
AUTH_MODE=byd

# byd 로그인 허용 사용자 (쉼표 구분, 비우면 SAP 인증에 성공한 모든 사용자)
ALLOWED_USERS=

# local 로그인 계정 (이름:비밀번호, 쉼표 구분)
APP_USERS=admin:change-me

# 로그인 유지 시간(시간)
SESSION_HOURS=8

# ── SAP ByD ───────────────────────────────────────────
# 테넌트 주소 (예: my123456.sapbydesign.com)
BYD_BASE_URL=

# 로그인 확인에 호출할 ByD 경로 (비우면 BOM OData 서비스의 $metadata)
# BYD_AUTH_CHECK_PATH=/sap/byd/odata/cust/v1/zbom/$metadata

# BOM 데이터: mock = 내장 샘플 데이터 / byd = 실제 ByD 데이터
BYD_MODE=mock

# 아래는 BYD_MODE=byd 일 때 필요 (Communication Arrangement 의 통신 사용자)
BYD_USER=
BYD_PASSWORD=
BYD_ODATA_BOM_PATH=/sap/byd/odata/cust/v1/zbom
BYD_ODATA_MATERIAL_PATH=/sap/byd/odata/cust/v1/zmaterial
BYD_SOAP_BOM_URL=
BYD_TIMEOUT_MS=30000

# HTTPS 리버스 프록시 뒤에서 실행하면 1
TRUST_PROXY=0

# 포트
PORT=3000

# 데이터 폴더 (업로드 이력, Mock 데이터 저장)
# DATA_DIR=./data

# 웹 로그인 사용자 (이름:비밀번호, 쉼표로 구분). 비우면 로그인 없이 동작
APP_USERS=admin:change-me

# ── ByD 연동 ───────────────────────────────────────────
# mock = 내장 샘플 데이터 / byd = 실제 ByD 테넌트
BYD_MODE=mock

# 테넌트 주소
BYD_BASE_URL=https://my000000.sapbydesign.com
# Communication Arrangement 의 통신 사용자
BYD_USER=_BOMPORTAL
BYD_PASSWORD=

# Custom OData 서비스 경로 (Application and User Management > OData Services 에서 생성)
BYD_ODATA_BOM_PATH=/sap/byd/odata/cust/v1/zbom
BYD_ODATA_MATERIAL_PATH=/sap/byd/odata/cust/v1/zmaterial

# BOM 관리 SOAP 서비스 엔드포인트 (Communication Arrangement 에서 확인)
BYD_SOAP_BOM_URL=

BYD_TIMEOUT_MS=30000
